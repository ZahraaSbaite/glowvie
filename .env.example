DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
JWT_SECRET="replace-with-a-long-random-string"

# Used to set the "secure" cookie flag correctly in production
NODE_ENV="development"

# --- Optional integrations (site works without these, features degrade gracefully) ---

# Cloudinary (image uploads for gallery/services in the admin panel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (appointment confirmations + reminders) — any SMTP provider (Resend, SendGrid, Gmail SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Glow Vie Beauty Clinic <hello@glowvie.com>"

# Instagram Basic Display / Graph API token, for the auto-pulled Instagram feed section
INSTAGRAM_ACCESS_TOKEN=""

NEXT_PUBLIC_WHATSAPP_NUMBER="9613000000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
